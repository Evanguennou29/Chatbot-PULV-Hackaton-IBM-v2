# Copier vers .env. Ne jamais versionner la clé.
IBM_CLOUD_API_KEY=
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
# Renseigner un projet OU un espace, jamais les deux.
WATSONX_PROJECT_ID=
